#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BO840 Case Manager
Читает cases_queue.md, добавляет кейсы в graph.json, обновляет связи и индексы.

Использование:
    python bo840_manager.py graph.json cases_queue.md
"""

import sys
import json
import re
from pathlib import Path
from datetime import datetime


class BO840Manager:
    """Менеджер кейсов БО840 — добавляет кейсы из очереди в граф"""

    TYPE_MAP = {
        "аксиома": "axiom", "переменная": "variable", "ось": "axis",
        "механика": "mechanic", "эмоция": "emotion", "ловушка": "trap",
        "детское_правило": "childhood_rule", "метод": "method",
        "протокол": "protocol", "кейс": "case", "концепт": "concept"
    }

    def __init__(self, graph_path, queue_path):
        self.graph_path = Path(graph_path)
        self.queue_path = Path(queue_path)
        self.graph = self._load_graph()
        self.added_count = 0
        self.updated_count = 0

    def _load_graph(self):
        """Загружает graph.json или создаёт минимальный"""
        if self.graph_path.exists():
            with open(self.graph_path, "r", encoding="utf-8") as f:
                return json.load(f)
        return {
            "meta": {"version": "3.3", "date": "", "nodes_count": 0},
            "schema": {
                "node_types": list(self.TYPE_MAP.values()) + ["concept"],
                "levels": ["L0", "L1", "L2", "L3", "L4", "L5"],
                "statuses": ["draft", "hypothesis", "approved"],
                "relation_types": ["closes", "closed_by", "shifts_up", "shifts_down",
                                  "diagnoses", "source_of", "leads_to", "part_of", "requires"]
            },
            "nodes": {},
            "cases": {},
            "index": {"by_tag": {}, "by_type": {}, "by_file": {}}
        }

    def _save_graph(self):
        """Сохраняет graph.json"""
        self.graph["meta"]["date"] = datetime.now().isoformat()
        self.graph["meta"]["nodes_count"] = len(self.graph["nodes"])
        with open(self.graph_path, "w", encoding="utf-8") as f:
            json.dump(self.graph, f, ensure_ascii=False, indent=2)
        size = self.graph_path.stat().st_size
        print(f"\n✅ graph.json сохранён: {self.graph_path}")
        print(f"   Узлов: {len(self.graph['nodes'])}, Кейсов: {len(self.graph['cases'])}")
        print(f"   Размер: {size:,} байт")

    def _detect_type(self, node_id):
        """Определяет тип по префиксу ID"""
        for prefix, ntype in self.TYPE_MAP.items():
            if node_id.startswith(prefix):
                return ntype
        return "concept"

    def _extract_tags(self, text):
        """Извлекает все теги #префикс_название"""
        pattern = r'#([а-яa-z0-9_]+_[а-яa-z0-9_]+)'
        return sorted(list(set(re.findall(pattern, text))))

    def _parse_list_field(self, text, field_name):
        """Парсит список из markdown: - item1 - item2"""
        pattern = rf"\*\*{field_name}:\*\*\s*\n((?:\s*[-•]\s*[^\n]+\n?)+)"
        match = re.search(pattern, text, re.IGNORECASE)
        if not match:
            return []
        lines = match.group(1).strip().split("\n")
        items = []
        for line in lines:
            line = line.strip()
            if line.startswith("-") or line.startswith("•"):
                items.append(line[1:].strip())
        return items

    def _parse_dict_field(self, text, field_name):
        """Парсит словарь из markdown: - key: value"""
        pattern = rf"\*\*{field_name}:\*\*\s*\n((?:\s*[-•]\s*[^\n]+\n?)+)"
        match = re.search(pattern, text, re.IGNORECASE)
        if not match:
            return {}
        lines = match.group(1).strip().split("\n")
        result = {}
        for line in lines:
            line = line.strip()
            if line.startswith("-") or line.startswith("•"):
                line = line[1:].strip()
                if ":" in line:
                    key, val = line.split(":", 1)
                    result[key.strip()] = val.strip()
        return result

    def _parse_block_field(self, text, field_name):
        """Парсит многострочное поле"""
        pattern = rf"\*\*{field_name}:\*\*\s*\n(.*?)(?=\n\*\*|\n### |\n---|$)"
        match = re.search(pattern, text, re.IGNORECASE | re.DOTALL)
        if match:
            return match.group(1).strip()
        return ""

    def _parse_relation_line(self, line):
        """Парсит строку связи: 'аксиома_крест_выше_меры (diagnoses)'"""
        line = line.strip()
        # Формат: target (type)  или  target - type  или  target
        m = re.match(r"([а-яa-z0-9_]+)\s*[\(\-]\s*([a-z_]+)[\)]?", line)
        if m:
            return {"target": m.group(1), "type": m.group(2)}
        # Просто target — default type = "diagnoses"
        if re.match(r"^[а-яa-z0-9_]+$", line):
            return {"target": line, "type": "diagnoses"}
        return None

    def _parse_relations(self, text):
        """Парсит relations из текста"""
        lines = self._parse_list_field(text, "relations")
        relations = []
        for line in lines:
            rel = self._parse_relation_line(line)
            if rel:
                relations.append(rel)
        return relations

    def _extract_front_matter(self, case_text):
        """Извлекает front matter из начала блока кейса"""
        fm = {}
        lines = case_text.split("\n")
        for line in lines:
            line = line.strip()
            if line.startswith("type:"):
                fm["type"] = line.split(":", 1)[1].strip()
            elif line.startswith("level:"):
                fm["level"] = line.split(":", 1)[1].strip()
            elif line.startswith("status:"):
                fm["status"] = line.split(":", 1)[1].strip()
            elif line.startswith("title:"):
                fm["title"] = line.split(":", 1)[1].strip()
        return fm

    def _parse_case(self, case_text):
        """Парсит один блок кейса из очереди"""
        # Ищем ID: ### #кейс_xxx — Название
        header_match = re.search(r"###\s+#([а-яa-z0-9_]+)\s*[—\-]?\s*(.*)", case_text)
        if not header_match:
            return None

        node_id = header_match.group(1)
        title = header_match.group(2).strip()

        fm = self._extract_front_matter(case_text)
        node_type = fm.get("type", self._detect_type(node_id))

        # Парсим поля
        patterns = self._parse_list_field(case_text, "patterns_detected")
        variables = self._parse_dict_field(case_text, "variables")
        summary = self._parse_block_field(case_text, "summary")
        content = self._parse_block_field(case_text, "content")
        relations = self._parse_relations(case_text)

        # Теги: все теги из текста + ID кейса + БО840
        tags = self._extract_tags(case_text)
        if node_id not in tags:
            tags.append(node_id)
        if "БО840" not in tags:
            tags.append("БО840")
        tags = [f"#{t}" for t in sorted(tags)]

        case_data = {
            "type": node_type,
            "level": fm.get("level", ""),
            "status": fm.get("status", "draft"),
            "title": fm.get("title", title),
            "tags": tags,
            "relations": relations,
            "source_file": str(self.queue_path.name),
        }

        if patterns:
            case_data["patterns_detected"] = patterns
        if variables:
            case_data["variables"] = variables
        if summary:
            case_data["summary"] = summary
        if content:
            case_data["content"] = content
        elif case_text.strip():
            # Если content не задан явно, берём весь текст после заголовка
            body = case_text.split("###", 1)[1] if "###" in case_text else case_text
            case_data["content"] = body[:800] + "..." if len(body) > 800 else body

        return node_id, case_data

    def _split_queue(self, text):
        """Разбивает очередь на отдельные кейсы"""
        # Разделитель: строка с ### #кейс_ или ### #любой_тег
        pattern = r"(?=\n###\s+#[а-яa-z0-9_]+)"
        parts = re.split(pattern, text)
        cases = []
        for part in parts:
            part = part.strip()
            if re.search(r"###\s+#[а-яa-z0-9_]+", part):
                cases.append(part)
        return cases

    def _update_indexes(self, node_id, node_data):
        """Обновляет индексы graph.json"""
        ntype = node_data.get("type", "unknown")
        self.graph["index"]["by_type"].setdefault(ntype, [])
        if node_id not in self.graph["index"]["by_type"][ntype]:
            self.graph["index"]["by_type"][ntype].append(node_id)

        src = node_data.get("source_file", "unknown")
        self.graph["index"]["by_file"].setdefault(src, [])
        if node_id not in self.graph["index"]["by_file"][src]:
            self.graph["index"]["by_file"][src].append(node_id)

        for tag in node_data.get("tags", []):
            tag_clean = tag.lstrip("#")
            self.graph["index"]["by_tag"].setdefault(tag_clean, [])
            if node_id not in self.graph["index"]["by_tag"][tag_clean]:
                self.graph["index"]["by_tag"][tag_clean].append(node_id)

    def _auto_relations(self, node_id, node_data):
        """Автоматически добавляет связи, если в тексте упоминаются другие узлы"""
        text = json.dumps(node_data, ensure_ascii=False)
        existing_targets = {r["target"] for r in node_data.get("relations", [])}

        # Ищем все теги в тексте
        all_tags = self._extract_tags(text)
        for tag in all_tags:
            if tag == node_id:
                continue
            tag_clean = tag.lstrip("#")
            # Если тег существует в графе и ещё не связан
            if tag_clean in self.graph["nodes"] and tag_clean not in existing_targets:
                node_data["relations"].append({
                    "target": tag_clean,
                    "type": "diagnoses"
                })
                print(f"   🔗 Авто-связь: {node_id} → {tag_clean} (diagnoses)")

    def add_case(self, node_id, case_data):
        """Добавляет или обновляет кейс в графе"""
        if node_id in self.graph["nodes"]:
            print(f"⚠️  {node_id} уже существует, обновляем...")
            self.updated_count += 1
        else:
            print(f"✅ Добавлен: {node_id} — {case_data.get('title', '')}")
            self.added_count += 1

        # Добавляем в nodes и cases
        self.graph["nodes"][node_id] = case_data
        self.graph["cases"][node_id] = case_data

        # Авто-связи
        self._auto_relations(node_id, case_data)

        # Обновляем индексы
        self._update_indexes(node_id, case_data)

    def process_queue(self):
        """Обрабатывает очередь кейсов"""
        if not self.queue_path.exists():
            print(f"❌ Файл очереди не найден: {self.queue_path}")
            return

        text = self.queue_path.read_text(encoding="utf-8")
        case_blocks = self._split_queue(text)

        print(f"📥 Найдено кейсов в очереди: {len(case_blocks)}")
        print("-" * 50)

        for block in case_blocks:
            result = self._parse_case(block)
            if result:
                node_id, case_data = result
                self.add_case(node_id, case_data)
            else:
                print("⚠️  Пропущен блок (не удалось распарсить)")

        print("-" * 50)
        self._save_graph()
        print(f"\n📊 Итог: добавлено {self.added_count}, обновлено {self.updated_count}")


def main():
    if len(sys.argv) < 3:
        print("Использование: python bo840_manager.py <graph.json> <cases_queue.md>")
        print("Пример: python bo840_manager.py ./graph.json ./cases_queue.md")
        sys.exit(1)

    graph_path = sys.argv[1]
    queue_path = sys.argv[2]

    manager = BO840Manager(graph_path, queue_path)
    manager.process_queue()


if __name__ == "__main__":
    main()